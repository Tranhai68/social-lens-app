# Cấu hình cổng chạy ứng dụng
PORT=3888

# Google Gemini API Key (dùng để phân tích 13 chuyên mục AI & so sánh đa kênh)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Apify API Token (dùng để quét Facebook Posts, Facebook Ads Library, TikTok, Instagram, YouTube)
APIFY_TOKEN=

# RapidAPI Key (tùy chọn - dùng cho các endpoint quét nhanh TikTok/FB/IG/Shopee)
RAPIDAPI_KEY=

